# Токен T-Invest API: https://www.tbank.ru/invest/settings/api/
TBANK_INVEST_TOKEN=t.your_token_here

# production | sandbox
TBANK_INVEST_ENV=sandbox

# Разрешить торговые операции (заявки, стопы, переводы). По умолчанию только чтение.
TBANK_ALLOW_TRADING=false

# Служебный заголовок x-app-name
TBANK_APP_NAME=AEI2.tbank_mcp_and_api

# HTTP API
TBANK_API_HOST=0.0.0.0
TBANK_API_PORT=8080

# Streamable HTTP MCP (/mcp): разрешённые Origin через запятую, или *
# TBANK_MCP_ALLOWED_ORIGINS=localhost,127.0.0.1,[::1]
# Требовать Mcp-Session-Id после initialize
# TBANK_MCP_REQUIRE_SESSION=false
# TTL сессии MCP, секунды
# TBANK_MCP_SESSION_TTL=3600

# Счёт по умолчанию (необязательно)
# TBANK_DEFAULT_ACCOUNT_ID=

# Таймаут запросов к T-Invest, секунды
TBANK_REQUEST_TIMEOUT=30
